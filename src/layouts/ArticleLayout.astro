---
import Base from './Base.astro';
import TableOfContents from '../components/TableOfContents.astro';
import QuickTakeaways from '../components/QuickTakeaways.astro';

interface Props {
  headings: import('astro').MarkdownHeading[];
  title: string;
  description: string;
  author: string;
  publishDate: Date;
  readingTime: number;
  tags: string[];
  takeaways?: string[];
  language: 'en' | 'tr';
  alternateLinks?: {
    en: string;
    tr: string;
  };
}

const {
  title,
  description,
  author,
  publishDate,
  readingTime,
  tags,
  language,
  alternateLinks,
  headings,
  takeaways,
} = Astro.props;

const isTurkish = language === 'tr';

const formattedDate = publishDate.toLocaleDateString(
  isTurkish ? 'tr-TR' : 'en-US',
  {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  }
);
---

<Base
  title={`${title} | ProfOps.dev`}
  description={description}
  lang={language}
  alternateLinks={alternateLinks}
>
  <div class="article-page">
    <div class="article-container">

      <a
        href={isTurkish ? '/tr/insights/' : '/insights/'}
        class="back-link"
      >
        ← {isTurkish ? 'Tüm Yazılar' : 'All Insights'}
      </a>

      <header class="article-header">
        <div class="article-label">
          ENGINEERING INSIGHTS
        </div>

        <h1>{title}</h1>

        <p class="article-description">
          {description}
        </p>

        <div class="article-meta">
          <span>{author}</span>
          <span class="separator">•</span>
          <span>{formattedDate}</span>
          <span class="separator">•</span>
          <span>
            {readingTime} {isTurkish ? 'dk okuma' : 'min read'}
          </span>
        </div>

        <div class="article-tags">
          {tags.map((tag) => (
            <span class="tag">{tag}</span>
          ))}
        </div>
      </header>

      <div class="article-divider"></div>

      <div class="article-reading-area">
      <QuickTakeaways
        items={takeaways ?? []}
        lang={language}
      />

      <TableOfContents headings={headings} lang={language} />

      <article class="article-content">
        <slot />
      </article>

      <footer class="article-footer">
        <div class="footer-divider"></div>

        <h2>
          {isTurkish
            ? 'Birlikte Keşfedelim! 💜'
            : "Let's Explore Together! 💜"}
        </h2>

        <p>
          {isTurkish
            ? 'Mühendislik deneyimlerini, fikirlerini ve sorularını paylaş.'
            : 'Share your engineering experiences, ideas, and questions.'}
        </p>

        <a
          href={isTurkish ? '/tr/insights/' : '/insights/'}
          class="footer-link"
        >
          ← {isTurkish ? 'Diğer Yazılar' : 'Explore More Insights'}
        </a>
      </footer>

    </div>
  </div>
</Base>

<style is:global>

  .article-page {
    min-height: 100vh;
    padding: 70px 24px 100px;
  }

  .article-container {
    max-width: 900px;
    margin: 0 auto;
  }

  .back-link {
    display: inline-block;
    margin-bottom: 48px;
    color: #22d3ee;
    text-decoration: none;
    font-size: 0.9rem;
  }

  .back-link:hover {
    color: #a78bfa;
  }

  .article-header {
    margin-bottom: 55px;
  }

  .article-label {
    color: #a78bfa;
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    font-weight: 700;
    margin-bottom: 20px;
  }

  .article-header h1 {
    color: #f9fafb;
    font-size: clamp(2.2rem, 5vw, 3.6rem);
    line-height: 1.2;
    letter-spacing: -0.04em;
    margin: 0 0 24px;
  }

  .article-description {
    color: #9ca3af;
    font-size: 1.15rem;
    max-width: 750px;
    margin-bottom: 28px;
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    color: #9ca3af;
    font-size: 0.85rem;
    margin-bottom: 24px;
  }

  .separator {
    color: #a78bfa;
  }

  .article-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .tag {
    padding: 5px 12px;
    border: 1px solid #374151;
    border-radius: 999px;
    color: #c4b5fd;
    font-size: 0.75rem;
  }

  .article-divider,
  .footer-divider {
    height: 1px;
    background: linear-gradient(
      to right,
      #a78bfa,
      #22d3ee,
      transparent
    );
  }

  .article-content {
    padding-top: 12px;
    font-size: 1rem;
  }

  .article-content h2 {
    margin-top: 55px;
    color: #f9fafb;
    font-size: 1.7rem;
    line-height: 1.3;
  }

  .article-content h3 {
    margin-top: 35px;
    color: #c4b5fd;
    font-size: 1.25rem;
  }

  .article-content p {
    margin: 20px 0;
  }

  .article-content a {
    color: #22d3ee;
  }

  .article-content blockquote {
    margin: 30px 0;
    padding: 20px 24px;
    border-left: 4px solid #a78bfa;
    background: #151b2b;
    border-radius: 0 12px 12px 0;
    color: #e9d5ff;
  }

  .article-content pre {
    padding: 22px;
    border-radius: 12px;
    overflow-x: auto;
    margin: 28px 0;
    border: 1px solid #293244;
  }

  .article-content code:not(pre code) {
    background: #1e293b;
    padding: 3px 6px;
    border-radius: 5px;
    color: #67e8f9;
    font-size: 0.9em;
  }

  .article-content ul,
  .article-content ol {
    padding-left: 25px;
  }

  .article-content li {
    margin-bottom: 10px;
  }

  .article-content table {
    width: 100%;
    border-collapse: collapse;
    margin: 30px 0;
    font-size: 0.9rem;
  }

  .article-content th,
  .article-content td {
    padding: 14px;
    border: 1px solid #374151;
    text-align: left;
  }

  .article-content th {
    background: #1e293b;
    color: #c4b5fd;
  }

  .article-footer {
    margin-top: 90px;
    text-align: center;
  }

  .article-footer h2 {
    margin-top: 35px;
    color: #c4b5fd;
  }

  .article-footer p {
    color: #9ca3af;
  }

  .footer-link {
    display: inline-block;
    margin-top: 20px;
    color: #22d3ee;
    text-decoration: none;
  }

  @media (max-width: 640px) {
    .article-page {
      padding: 35px 18px 70px;
    }

    .article-header {
      margin-bottom: 35px;
    }

    .article-content h2 {
      font-size: 1.45rem;
    }

    .article-meta {
      gap: 8px;
    }
  }

   /* Engineer's Perspective */

  .article-content blockquote {
      margin: 32px 0;
      padding: 24px 28px;
      background: linear-gradient(135deg, #10232b, #111827);
      border: 1px solid #256b75;
      border-left: 4px solid #22d3ee;
      border-radius: 12px;
      color: #e2e8f0;
  }

  .article-content blockquote strong {
      color: #67e8f9;
  }

  .article-content blockquote p {
      line-height: 1.7;
  }

  .article-content blockquote p:last-child {
      margin-bottom: 0;
  }
</style>