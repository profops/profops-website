---
import Base from '../../layouts/Base.astro';

const title = "ProfOps.dev'e Hoş Geldiniz — Birlikte Keşfedelim";
---

<Base
  title={title}
  description="DevOps, Platform Engineering, Cloud Native, SRE ve yapay zekâ üzerine gerçek mühendislik deneyimleri, teknik yazılar ve uygulamalı çalışmalar."
  lang="tr"
>
  <section class="home-coming-soon">
    <div class="home-coming-soon-inner">

      <!-- Brand -->
      <div class="home-brand">
        <span class="home-mark" aria-hidden="true">&gt;_</span>
        <span>
          Prof<span class="purple">Ops</span><span class="cyan">.dev</span>
        </span>
      </div>

      <!-- Welcome label -->
      <div class="home-coming-pill">
        MÜHENDİSLİK · TOPLULUK · KEŞİF
      </div>

      <!-- Main heading -->
      <h1>
        ProfOps.dev'e
        <span class="purple">Hoş Geldiniz!</span>
      </h1>

      <!-- Subtitle -->
      <h2 class="home-welcome-subtitle">
        Birlikte <span class="cyan">Keşfedelim.</span>
      </h2>

      <!-- Description -->
      <p class="home-lead">
        Gerçek mühendislik deneyimlerini, teknik bilgileri
        ve uygulamalı çalışmaları paylaşabileceğimiz bir alan.
      </p>

      <!-- Action buttons -->
      <div class="home-actions">
        <a href="/tr/about" class="home-btn home-btn-primary">
          ProfOps'u Keşfet →
        </a>

        <a href="/tr/about" class="home-btn home-btn-secondary">
          Fikrini Paylaş ↗
        </a>
      </div>

      <!-- Topics -->
      <div class="home-topics">
        <span>DevOps</span>
        <span>Platform Engineering</span>
        <span>Cloud Native</span>
        <span>SRE</span>
        <span>AI &amp; Automation</span>
      </div>

      <!-- Upcoming content -->
      <div class="home-upcoming">
        <span>🛠️</span>
        Teknik yazılar ve uygulamalı çalışmalar çok yakında!
      </div>

    </div>
  </section>
</Base>