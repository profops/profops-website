---
const title = 'ProfOps.dev — Coming Soon';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="ProfOps — an engineering magazine and hands-on lab for DevOps, Platform Engineering, Cloud Native, SRE and AI. Launching soon." />
    <meta name="robots" content="index,follow" />
    <meta name="theme-color" content="#0B0F17" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
    <style>
      :root { color-scheme: dark; font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; }
      * { box-sizing: border-box; }
      body { margin: 0; min-height: 100vh; color: #f8fafc; background: radial-gradient(ellipse at 50% 5%, #202047 0%, transparent 50%), #0b0f17; }
      main { min-height: 100vh; display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center; padding: 42px 24px; }
      .brand { display: inline-flex; align-items: center; gap: 12px; font-size: clamp(27px, 5vw, 38px); font-weight: 800; letter-spacing: -1.8px; }
      .mark { display: inline-grid; place-items: center; height: 45px; width: 45px; border: 1px solid #335d71; border-radius: 13px; color: #22d3ee; font-size: 23px; font-weight: 600; letter-spacing: -2px; }
      .purple { color: #a78bfa; } .cyan { color: #22d3ee; }
      .pill { margin-top: 62px; padding: 9px 17px; border: 1px solid #38435a; border-radius: 999px; color: #bfc7db; background: #161b2b; font-size: 12px; font-weight: 750; letter-spacing: 2.5px; }
      h1 { max-width: 820px; margin: 24px 0 18px; font-size: clamp(39px, 7.2vw, 75px); line-height: 1.1; letter-spacing: -2.5px; }
      .lead { max-width: 620px; color: #aab5c5; line-height: 1.75; font-size: clamp(16px, 2vw, 19px); }
      .tagline { margin-top: 26px; font-size: 16px; font-weight: 650; color: #22d3ee; }
      .topics { display: flex; justify-content: center; flex-wrap: wrap; gap: 9px; margin-top: 42px; }
      .topics span { border: 1px solid #2c3547; border-radius: 8px; padding: 9px 13px; background: #141b29; color: #b5bfd0; font-size: 13px; }
      footer { margin-top: 75px; padding-top: 22px; border-top: 1px solid #293344; color: #8491a5; font-size: 13px; width: min(480px, 100%); }
      @media (prefers-reduced-motion: no-preference) { .mark { animation: glow 4s ease-in-out infinite; } @keyframes glow { 50% { box-shadow: 0 0 20px #22d3ee22; } } }
    </style>
  </head>
  <body>
    <main>
      <div class="brand"><span class="mark" aria-hidden="true">&gt;_</span><span>Prof<span class="purple">Ops</span><span class="cyan">.dev</span></span></div>
      <div class="pill">COMING SOON</div>
      <h1>Something great is <span class="purple">in the making.</span></h1>
      <p class="lead">A new space for real-world engineering insights, cloud-native architectures and hands-on labs.</p>
      <div class="tagline">Engineering the future. Launching soon. ↗</div>
      <div class="topics"><span>DevOps</span><span>Platform Engineering</span><span>Cloud Native</span><span>SRE</span><span>AI &amp; Automation</span></div>
      <footer>Built by engineers, for engineers. · © {new Date().getFullYear()} ProfOps</footer>
    </main>
  </body>
</html>
