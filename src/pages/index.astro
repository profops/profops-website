---
import Base from '../layouts/Base.astro';

const title = 'ProfOps.dev — Coming Soon';
---

<Base
  title={title}
  description="ProfOps — an engineering magazine and hands-on lab for DevOps, Platform Engineering, Cloud Native, SRE and AI. Launching soon."
  lang="en"
>
  <section class="home-coming-soon">
    <div class="home-coming-soon-inner">

      <div class="home-brand">
        <span class="home-mark" aria-hidden="true">&gt;_</span>
        <span>
          Prof<span class="purple">Ops</span><span class="cyan">.dev</span>
        </span>
      </div>

      <div class="home-coming-pill">COMING SOON</div>

      <h1>
        Something great is
        <span class="purple">in the making.</span>
      </h1>

      <p class="home-lead">
        A new space for real-world engineering insights,
        cloud-native architectures and hands-on labs.
      </p>

      <div class="home-tagline">
        Engineering the future. Launching soon. ↗
      </div>

      <div class="home-topics">
        <span>DevOps</span>
        <span>Platform Engineering</span>
        <span>Cloud Native</span>
        <span>SRE</span>
        <span>AI &amp; Automation</span>
      </div>

      <div class="home-bottom">
        Built by engineers, for engineers. ·
        © {new Date().getFullYear()} ProfOps
      </div>

    </div>
  </section>
</Base>