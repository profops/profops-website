---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
  lang?: 'en' | 'tr';
}

const { headings, lang = 'en' } = Astro.props;

const sections = headings.filter(
  (heading) => heading.depth === 2 || heading.depth === 3
);
---

{sections.length > 0 && (
  <nav class="toc" aria-label={lang === 'tr' ? 'İçindekiler' : 'Table of contents'}>
    <h2>{lang === 'tr' ? 'İçindekiler' : 'On This Page'}</h2>

    <ul>
      {sections.map((heading) => (
        <li class:list={{ nested: heading.depth === 3 }}>
          <a href={`#${heading.slug}`}>{heading.text}</a>
        </li>
      ))}
    </ul>
  </nav>
)}

<style>
  .toc {
    margin: 0 0 36px;
    padding: 24px 28px;
    background: #111827;
    border: 1px solid #293244;
    border-radius: 16px;
  }

  .toc h2 {
    margin: 0 0 16px;
    color: #c4b5fd;
    font-size: 1.1rem;
  }

  .toc ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .toc li {
    margin: 9px 0;
  }

  .toc li.nested {
    padding-left: 20px;
  }

  .toc a {
    color: #cbd5e1;
    text-decoration: none;
    font-size: 0.92rem;
    line-height: 1.5;
  }

  .toc a:hover {
    color: #22d3ee;
  }
</style>