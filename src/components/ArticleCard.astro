---
interface Props {
  title: string;
  description: string;
  href: string;
  category: string;
  author: string;
  readingTime: number;
  publishDate: Date;
  lang?: 'en' | 'tr';
}

const {
  title,
  description,
  href,
  category,
  author,
  readingTime,
  publishDate,
  lang = 'en',
} = Astro.props;

const isTurkish = lang === 'tr';

const formattedDate = publishDate.toLocaleDateString(
  isTurkish ? 'tr-TR' : 'en-US',
  {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  }
);
---

<a href={href} class="article-card">
  <div class="article-card-category">{category}</div>

  <h2>{title}</h2>

  <p class="article-card-description">
    {description}
  </p>

  <div class="article-card-meta">
    <span>{author}</span>
    <span>·</span>
    <time datetime={publishDate.toISOString()}>
      {formattedDate}
    </time>
    <span>·</span>
    <span>
      {readingTime} {isTurkish ? 'dk okuma' : 'min read'}
    </span>
  </div>

  <span class="article-card-link">
    {isTurkish ? 'Yazıyı Oku' : 'Read Article'} →
  </span>
</a>

<style>
  .article-card {
    display: block;
    padding: 30px;
    border: 1px solid #293244;
    border-radius: 16px;
    background: #111827;
    text-decoration: none;
    transition:
      transform 0.2s ease,
      border-color 0.2s ease;
  }

  .article-card:hover {
    transform: translateY(-4px);
    border-color: #a78bfa;
  }

  .article-card-category {
    color: #a78bfa;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 16px;
  }

  .article-card h2 {
    color: #f9fafb;
    font-size: 1.5rem;
    line-height: 1.35;
    margin: 0 0 14px;
  }

  .article-card-description {
    color: #9ca3af;
    line-height: 1.7;
    margin-bottom: 24px;
  }

  .article-card-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    color: #9ca3af;
    font-size: 0.8rem;
    margin-bottom: 24px;
  }

  .article-card-link {
    color: #22d3ee;
    font-size: 0.9rem;
    font-weight: 600;
  }

  @media (max-width: 640px) {
    .article-card {
      padding: 22px;
    }

    .article-card h2 {
      font-size: 1.25rem;
    }
  }
</style>